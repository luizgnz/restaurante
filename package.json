{
  "name": "restaurante",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:go": "go test ./go/...",
    "test:watch": "vitest",
    "dev": "go run ./go/cmd/restaurante",
    "dev:node": "tsx src/index.ts",
    "dev:go": "go run ./go/cmd/restaurante",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config ui/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:go": "mkdir -p dist && go build -o dist/restaurante-go ./go/cmd/restaurante",
    "start:node": "node --import tsx src/index.ts",
    "start": "npm run build:ui && npm run build:go && ./dist/restaurante-go",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.3",
    "lucide-react": "^1.33.0",
    "tailwind-merge": "^3.6.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
